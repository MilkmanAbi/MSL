<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Do NOT sign with this unless you have a provisioning profile that
     grants it. com.apple.vm.device-access is a restricted entitlement:
     ad-hoc signing it is accepted by codesign and then the kernel
     SIGKILLs the process at exec (measured, exit 137). MSL does not use
     it - IOUSBHostObjectInitOptionsDeviceCapture takes root instead.
     Kept only to document what the paid-entitlement path would need. -->
<plist version="1.0">
<dict>
    <key>com.apple.vm.device-access</key>
    <true/>
</dict>
</plist>
